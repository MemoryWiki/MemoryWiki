include README.md README.zh.md ROADMAP.md LICENSE CHANGELOG.md SECURITY.md CONTRIBUTING.md CODE_OF_CONDUCT.md
include pyproject.toml
recursive-include docs *
recursive-include examples *
recursive-include benchmarks *
recursive-exclude docs/internal *
recursive-exclude examples */retrieval/*.jsonl
recursive-exclude * __pycache__ *.py[cod] .DS_Store
prune examples/memory-root/agent_slots
prune .git
prune .pytest_cache
prune build
prune dist
